<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.GestionFuncionalidadesViewController">
   <children>
      <Label layoutX="154.0" layoutY="23.0" text="¿QUE QUIERES SABER?">
         <font>
            <Font size="29.0" />
         </font>
      </Label>
      <TabPane layoutX="9.0" layoutY="66.0" prefHeight="318.0" prefWidth="586.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="Buscar Ordenes por dia de fehca">
               <content>
                  <AnchorPane prefHeight="200.0" prefWidth="200.0">
                     <children>
                        <Button fx:id="btnBuscarOrden" layoutX="256.0" layoutY="98.0" mnemonicParsing="false" text="Button" />
                        <Label layoutX="66.0" layoutY="14.0" prefHeight="35.0" prefWidth="453.0" text="Ingrese la fecha para filtrar las ordenes">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                        <TableView fx:id="tblOrdenFecha" layoutX="6.0" layoutY="134.0" prefHeight="142.0" prefWidth="570.0">
                          <columns>
                            <TableColumn fx:id="colFecId" prefWidth="66.4000244140625" text="id" />
                            <TableColumn fx:id="colFecHora" prefWidth="79.99993896484375" text="hora" />
                              <TableColumn fx:id="colFecMotivo" prefWidth="117.60003662109375" text="motivo" />
                              <TableColumn fx:id="colFecMecanico" prefWidth="134.39996337890625" text="Mecanico que arregló" />
                              <TableColumn fx:id="colFecCliente" prefWidth="172.79998779296875" text="Cliente Atendido" />
                          </columns>
                        </TableView>
                        <DatePicker fx:id="fechaIngresada" layoutX="205.0" layoutY="57.0" />
                     </children>
                  </AnchorPane>
               </content></Tab>
          <Tab text="Historial de servicios por Cicla">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="290.0" prefWidth="564.0">
                     <children>
                        <Label layoutX="4.0" layoutY="14.0" prefHeight="22.0" prefWidth="286.0" text="Ingrese el numero de marco de la bicicleta">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtNumeroMarco" layoutX="14.0" layoutY="50.0" />
                        <TableView fx:id="tblHistorial" layoutX="202.0" layoutY="50.0" prefHeight="211.0" prefWidth="384.0">
                          <columns>
                            <TableColumn fx:id="colHistId" prefWidth="66.4000244140625" text="id" />
                            <TableColumn fx:id="colHistFecha" prefWidth="76.0" text="Fecha" />
                              <TableColumn fx:id="colHistMarco" prefWidth="83.20001220703125" text="Marca cicla" />
                              <TableColumn fx:id="colHistMecanico" prefWidth="156.0" text="Mecanico encargado" />
                          </columns>
                        </TableView>
                        <Button fx:id="btnBuscar" layoutX="63.0" layoutY="103.0" mnemonicParsing="false" onAction="#buscarHistorial" text=" Buscar" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab text="Alerta de Stocks bajos">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <Label layoutX="80.0" layoutY="14.0" text="REPUESTOS BAJOS EN STOCK">
                           <font>
                              <Font size="30.0" />
                           </font>
                        </Label>
                        <TableView fx:id="tblStockBajo" layoutX="116.0" layoutY="67.0" prefHeight="200.0" prefWidth="353.0">
                          <columns>
                            <TableColumn fx:id="colStockId" prefWidth="75.0" text="id" />
                            <TableColumn fx:id="colStockNombre" prefWidth="75.0" text="nombre" />
                              <TableColumn fx:id="colStockPrecio" prefWidth="75.0" text="precio" />
                              <TableColumn fx:id="colStockCantidad" prefWidth="126.39996337890625" text="CantidadDisponible" />
                          </columns>
                        </TableView>
                     </children></AnchorPane>
              </content>
            </Tab>
        </tabs>
         <effect>
            <InnerShadow />
         </effect>
         <cursor>
            <Cursor fx:constant="DISAPPEAR" />
         </cursor>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </TabPane>
      <Label layoutX="-28.0" layoutY="99.0" text="Label" />
      <Button fx:id="btnVolver" layoutX="26.0" layoutY="10.0" mnemonicParsing="false" onAction="#onVolver" text="Volver" />
      <Button fx:id="btnActualizar" layoutX="494.0" layoutY="374.0" mnemonicParsing="false" text="Actualizar" />
   </children>
</AnchorPane>
