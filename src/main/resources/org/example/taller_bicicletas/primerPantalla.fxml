<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewController.PrimerPantallaViewController">
   <children>
      <Label layoutX="169.0" layoutY="14.0" prefHeight="86.0" prefWidth="290.0" text="Taller de Bicicletas" textOverrun="CLIP">
         <font>
            <Font size="35.0" />
         </font>
      </Label>
      <VBox layoutX="183.0" layoutY="114.0" prefHeight="200.0" prefWidth="262.0">
         <children>
            <Button fx:id="gestionCliente" mnemonicParsing="false" onAction="#gestionarCliente" prefHeight="26.0" prefWidth="286.0" text="Gestion Cliente">
               <font>
                  <Font size="14.0" />
               </font></Button>
            <Button fx:id="gestionMecanicos" mnemonicParsing="false" onAction="#gestionarMecanicos" prefHeight="26.0" prefWidth="301.0" text="Gestion Mecanicos">
               <font>
                  <Font size="14.0" />
               </font></Button>
            <Button fx:id="gestionCiclas" mnemonicParsing="false" onAction="#gestionarCiclas" prefHeight="26.0" prefWidth="316.0" text="Gestion Bicicletas">
               <font>
                  <Font size="14.0" />
               </font></Button>
            <Button fx:id="gestionRepuestos" mnemonicParsing="false" onAction="#gestionarRepuestos" prefHeight="26.0" prefWidth="362.0" text="Gestion Repuestos">
