            <Button fx:id="gestionOrden" mnemonicParsing="false" onAction="#gestionarOrdenes" prefHeight="26.0" prefWidth="309.0" text="Gestion Ordenes de servicio">
               <font>
                  <Font size="14.0" />
               </font></Button>
            <Button fx:id="otro" mnemonicParsing="false" onAction="#irOtrasFuncionalidades" prefHeight="26.0" prefWidth="317.0" text="Otras funciones">
               <font>
                  <Font size="14.0" />
               </font></Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
